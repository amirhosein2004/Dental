      "purpose": "any"
    },
    {
      "src": "{% static 'img/pwa/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/pwa/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "پیام‌های تماس",
      "short_name": "پیام‌ها",
      "url": "/contact/messages/"
    },
    {
      "name": "رزرو نوبت",
