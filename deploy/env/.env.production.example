# ---------------------------------------------------------------------------
# Production. Copy to env/.env.production ON THE SERVER — never commit the
# filled-in version, and never copy it back to a laptop.
#
# Every CHANGE-ME below is load-bearing. Three of them cannot be rotated
# without consequences worth knowing in advance:
#
#   SECRET_KEY       rotating it logs everyone out
#   OTP_SECRET_KEY   rotating it invalidates in-flight login codes
#   VAPID_*          rotating it silently unsubscribes every staff device
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=dental_production

DJANGO_ENV=production
DEBUG=False
SECRET_KEY=CHANGE-ME-generate-a-real-random-key
# Exactly the hostnames served. Not '*': Django echoes the Host header into
# the absolute URLs it builds, the password-reset link among them.
ALLOWED_HOSTS=sbdental.ir,www.sbdental.ir

DB_ENGINE=django.db.backends.postgresql
DB_NAME=dental_production
DB_USER=dental
DB_PASSWORD=CHANGE-ME-long-random-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
REDIS_URL_CELERY=redis://redis:6379/0

# --- SMS: this one spends money ---------------------------------------------
SMS_BACKEND=kavenegar
KAVENEGAR_API_KEY=CHANGE-ME
KAVENEGAR_SENDER=
# Who gets woken by a new contact message or booking.
STAFF_ALERT_NUMBERS=09120000000,09350000000

# --- Email -------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE-ME
EMAIL_HOST_PASSWORD=CHANGE-ME

# --- Obscured URL segments ---------------------------------------------------
OTP_SECRET_KEY=CHANGE-ME
SECURE_ADMIN_PANEL=CHANGE-ME-random-path

LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran
USE_I18N=True
USE_TZ=True

MEDIA_URL=/media/
MEDIA_ROOT=media
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# --- Object storage for uploads (ArvanCloud) ---------------------------------
# S3-compatible, so these are the ordinary AWS_* names; only the endpoint and
# the region are provider-specific.
#
# Leave the key, the secret and the bucket blank to turn the bucket off
# entirely: uploads then go to the media/ volume on disk, which nginx already
# serves. `_USE_S3` in production.py decides on the credentials themselves, so
# there is no separate on/off flag to disagree with them.
#
# Where to get each value, in the ArvanCloud panel:
#   1. Object storage > create a bucket. Its name is AWS_STORAGE_BUCKET_NAME.
#      Set its access to *public*, or AWS_QUERYSTRING_AUTH=False (which is what
#      production.py sets) produces URLs that 403 for every visitor.
#   2. The same page shows which region the bucket lives in. Endpoint and
#      region must be the region the bucket was actually created in:
#         Simin (Tehran)     https://s3.ir-thr-at1.arvanstorage.ir   ir-thr-at1
#         Shahriar (Tabriz)  https://s3.ir-tbz-sh1.arvanstorage.ir   ir-tbz-sh1
#   3. Object storage > access keys > create. It shows the secret **once**;
#      there is no way to read it again afterwards, only to issue a new pair.
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_STORAGE_BUCKET_NAME=CHANGE-ME
AWS_S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
AWS_S3_REGION_NAME=ir-thr-at1

# Optional. A custom domain or CDN hostname in front of the bucket — bare
# hostname, no https://, no trailing slash. Blank means media URLs point
# straight at the bucket.
AWS_S3_CUSTOM_DOMAIN=

# Optional. `virtual` is ArvanCloud's own scheme and the default; only set
# `path` for a gateway that cannot do <bucket>.<endpoint>, such as MinIO.
AWS_S3_ADDRESSING_STYLE=virtual

# --- Web push ----------------------------------------------------------------
#   python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=CHANGE-ME
VAPID_PRIVATE_KEY=CHANGE-ME
VAPID_SUBJECT=mailto:info@sbdental.ir

# --- Mirrors, because this server is in Iran ---------------------------------
# The image is built ON THE SERVER: it cannot pull one from GitLab's registry,
# and it cannot clone from GitHub or GitLab either. Code arrives over SSH
# (`make ship`) and `docker compose build` runs here. That build fetches from
# Debian's archive, from apt.postgresql.org and from PyPI, none of which this
# machine reaches — so each one is pointed at a mirror that it does reach.
#
# Blank means upstream. Leave every one of these blank on a laptop; filling
# them in there only makes the build slower and more fragile.
#
# Run `sh scripts/check-mirrors.sh` on the server first. It says which of
# these are actually reachable today, which is not a question the file can
# answer — Iranian mirrors move and close, and the ones below are a starting
# point, not a promise.

# Scheme and host, no trailing slash. It replaces the *host* in Debian's URLs,
# so apt then fetches `$APT_MIRROR/debian` and `$APT_MIRROR/debian-security`,
# and both of those paths must exist on the mirror. A URL that already ends in
# /debian becomes /debian/debian and 404s on every index file.
#
# It must also be a *Debian* mirror carrying the suite the image is built on
# — python:3.12-slim is **trixie** as of writing, and it moves with Debian, so
# a mirror that stops at bookworm breaks at the next base image bump. An
# Ubuntu mirror serves none of these paths, and apt reports the 404s as a
# missing release rather than as a wrong host.
#
# The two below are guesses about what this particular server can reach, not a
# recommendation. `sh scripts/check-mirrors.sh` answers it properly, and its
# answer is the only one worth trusting:
#   https://mirror.arvancloud.ir/repo
#   https://mirror.iranserver.com
APT_MIRROR=

# PostgreSQL's own apt repository, for the pg_dump that has to match the
# server's Postgres. Neither host below has an Iranian mirror — and neither
# needs one, because Debian trixie carries postgresql-client-17 itself. Set
# USE_PGDG=0 here and the build never asks for them.
#
# Set it back to 1 the day PG_MAJOR in the Dockerfile moves past what Debian
# ships. A client older than the server refuses to dump at all; a newer one
# writes a dump the server rejects on restore, which is the worse failure
# because it looks like a successful backup until the day it is needed.
USE_PGDG=0
PGDG_URL=https://apt.postgresql.org/pub/repos/apt
PGDG_ASC_URL=https://www.postgresql.org/media/keys/ACCC4CF8.asc

# Must end in /simple. TRUSTED_HOST is a bare hostname and is only needed for
# a mirror served over plain HTTP or with a certificate pip does not trust —
# without it those fail on SSL verification, with it pip stops checking that
# host's certificate at all, so do not set it for a mirror that does not need
# it.
PYPI_INDEX_URL=https://mirror-pypi.runflare.com/simple
PYPI_TRUSTED_HOST=

# Not read by anything here: postgres, redis, nginx and certbot are pulled
# from Docker Hub by the daemon, not by this build, so their mirror belongs in
# /etc/docker/daemon.json on the server:
#
#   { "registry-mirrors": ["https://<mirror-host>"] }
#   sudo systemctl restart docker
