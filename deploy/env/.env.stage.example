# ---------------------------------------------------------------------------
# Stage — production's shape, none of its reach. Copy to env/.env.stage.
#
# Every secret here must still be a *real* random value, not a placeholder:
# staging runs with DEBUG off and the same session and OTP machinery, so a
# weak SECRET_KEY is a weak session signature on a host that is reachable.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=dental_stage

DJANGO_ENV=stage
DEBUG=False
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=CHANGE-ME-generate-a-real-random-key
ALLOWED_HOSTS=stage.sbdental.ir,localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=dental_stage
DB_USER=dental
DB_PASSWORD=CHANGE-ME
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
REDIS_URL_CELERY=redis://redis:6379/0

# stage.py hard-codes the console backend regardless; leaving the real key out
# means even a settings mistake cannot spend credit.
SMS_BACKEND=console
KAVENEGAR_API_KEY=
# Testers' own numbers, never a patient's.
STAFF_ALERT_NUMBERS=

OTP_SECRET_KEY=CHANGE-ME
# Not `admin`: staging is reachable, and the panel should be no easier to find
# here than in production.
SECURE_ADMIN_PANEL=CHANGE-ME-random-path

LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran
USE_I18N=True
USE_TZ=True

MEDIA_URL=/media/
MEDIA_ROOT=media
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# A *separate* pair from production. Sharing them would let a staging test
# fire notifications at phones that subscribed on the live site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:stage@sbdental.ir
