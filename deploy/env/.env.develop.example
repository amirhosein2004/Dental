# ---------------------------------------------------------------------------
# Develop — your own machine. Copy to env/.env.develop and adjust.
#
# The values here are safe to commit as an example precisely because nothing
# in this file reaches anyone: SMS goes to the console, email to a file, and
# the database is a throwaway container.
# ---------------------------------------------------------------------------

# Compose derives container and volume names from this, which is what lets
# develop and production run side by side on one host.
COMPOSE_PROJECT_NAME=dental_develop

DJANGO_ENV=develop
DEBUG=True
SECRET_KEY=develop-insecure-key-not-for-any-real-host
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Tells develop.py to use the containers below instead of falling back to
# SQLite and in-memory everything. Without it the stack would start Postgres
# and Redis and then ignore both.
USE_CONTAINER_SERVICES=1

# `db` and `redis` are the compose service names, resolved on its network.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dental_develop
DB_USER=dental
DB_PASSWORD=develop-only-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
REDIS_URL_CELERY=redis://redis:6379/0

# develop.py forces these to safe backends anyway; listed so the file shows
# the full shape.
SMS_BACKEND=console
STAFF_ALERT_NUMBERS=09120000000

# Obscured URL segments. Any stable value works locally.
OTP_SECRET_KEY=develop-otp-key
SECURE_ADMIN_PANEL=admin

LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran
USE_I18N=True
USE_TZ=True

MEDIA_URL=/media/
MEDIA_ROOT=media
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Leave blank to disable push. Generate a pair with:
#   python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com
