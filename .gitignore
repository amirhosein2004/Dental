# Collected static assets — rebuilt by `manage.py collectstatic` on every
# deploy, and with hashed filenames it grows a new copy of every file each
# time. Never a source of truth.
staticfiles/

# Development mail drop: the file-based email backend writes here, and the
# messages contain live OTP codes.
sent_emails/

# Per-environment settings, kept under deploy/ rather than a top-level `env/`
# — that name is already ignored above as a virtualenv, and git does not
# descend into an ignored directory, so a negation inside it never applies.
# The `.example` files are committed as templates; the filled-in ones are not.
deploy/env/.env.*
!deploy/env/.env.*.example

# Database dumps. Never in git: a backup in the repository is the whole
# database handed to anyone who clones it.
backups/

# collectstatic output — built on every deploy, never committed.
/staticfiles/
