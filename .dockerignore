# `staticfiles/` is the *output* of collectstatic and is rebuilt inside the
# image. `static/` is the source — CSS, JS, fonts, the vendored Leaflet and
# Swiper — and must be copied in. Ignoring the wrong one of these left the
# image with nothing for collectstatic to collect.
staticfiles/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

