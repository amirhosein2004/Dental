logs/
*.log

# PostgreSQL data (if using Docker container)
pgdata/

# --- Never ship these ------------------------------------------------------
# `backups/` holds Postgres dumps: anyone with the image would have the
# database. `sent_emails/` holds development mail, including live OTP codes.
backups/
sent_emails/
media/
test_media/
.coverage
htmlcov/
.playwright-mcp/

# Environment files are read from the host by compose's `env_file`, never from
# inside the image — so a leaked image carries no credentials.
deploy/env/
env/
.env.*
