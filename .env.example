# ---------------------------------------------------------------------------
# Local development, on your own machine.
#
#     cp .env.example .env
#     python src/manage.py runserver
#
# Read by `src/manage.py`. Docker does NOT use this file — each container
# environment has its own:
#
#     .env                            runserver on your laptop   (this file)
#     deploy/env/.env.develop         the develop stack, in containers
#     deploy/env/.env.production      the live server
#
# The values here are safe to commit as an example because nothing in local
# development reaches anyone: SMS goes to the console, email to a file, and
# the database is a file you can delete.
# ---------------------------------------------------------------------------

# Which settings module to load: develop | production
DJANGO_ENV=develop

DEBUG=True

# Any non-empty string works locally. Production generates a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=local-development-key-not-for-any-real-host

# Loopback only. The live domain belongs in the production file — listing it
# here means a mistake about which environment you are in surfaces later, and
# less clearly, than it should.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Database and cache ----------------------------------------------------
# Blank on purpose. With USE_CONTAINER_SERVICES unset, `develop.py` ignores
# every setting in this section and uses SQLite, a local-memory cache and
# inline Celery — nothing to install before the site runs.
#
# The develop *stack* sets USE_CONTAINER_SERVICES=1 in its own env file, which
# is what makes it use the real containers. It does not belong here.
#
# Fill these in only to point runserver at a Postgres you installed on Windows
# yourself, and set USE_CONTAINER_SERVICES=1 alongside them.
USE_CONTAINER_SERVICES=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dental_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/1
REDIS_URL_CELERY=redis://127.0.0.1:6379/0

# --- Email -----------------------------------------------------------------
# `develop.py` overrides these to the file backend and writes into
# `sent_emails/`, so a login OTP is readable with no SMTP server — and a
# Persian subject cannot fail on the Windows console encoding, which the
# console backend does.
#
# Listed for the shape of the file. Leave them empty locally.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- SMS -------------------------------------------------------------------
# `console` prints the message instead of sending it. Never put a real
# Kavenegar key in this file: the code does not know it is running locally,
# so a test that sends is a text to a real patient.
SMS_BACKEND=console
STAFF_ALERT_NUMBERS=09120000000
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- Obscured URL segments -------------------------------------------------
# These become parts of real URLs. Any stable value works locally; production
# uses values that are not guessable.
OTP_SECRET_KEY=local-otp-key
RESET_PREFIX=reset-dev
RESET_SUFFIX=end-dev
SECURE_ADMIN_PANEL=admin

# --- Localization ----------------------------------------------------------
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran
USE_I18N=True
USE_TZ=True

# --- Static and media ------------------------------------------------------
# Relative to `src/`, which is BASE_DIR.
MEDIA_URL=/media/
MEDIA_ROOT=media
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# --- Web push (browser notifications for staff) ----------------------------
# Blank disables push. To try it locally:
#   python src/manage.py generate_vapid_keys
# Changing these invalidates every device that has already opted in.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com

# --- S3 media (production only) --------------------------------------------
# Unset locally: media is written to `src/media/` on disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
